{
  "id": "/admin",
  "name": "Kipper Admin",
  "short_name": "Kipper Admin",
  "description": "Administración de Organización Kipper: consultas, productores, foro y avisos.",
  "lang": "es-AR",
  "start_url": "/admin?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#601410",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Consultas", "url": "/admin/consultas", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Productores", "url": "/admin/productores", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Foro", "url": "/admin/foro", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Avisos push", "url": "/admin/avisos", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
