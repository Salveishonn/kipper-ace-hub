# Public site (optional overrides)
# Canonical production origin (no trailing slash).
VITE_SITE_URL=https://kipperseguros.com
# Use the real Kipper WhatsApp number in production (no placeholder).
VITE_WHATSAPP_NUMBER=5491151615276
VITE_PHONE_DISPLAY=(011) 5161-5276
VITE_CONTACT_EMAIL=info@kipperseguros.com.ar
VITE_OFFICE_ADDRESS=Colectora Este Ramal Escobar 959, 1623 Buenos Aires (Ingeniero Maschwitz)
VITE_INSTAGRAM_URL=https://www.instagram.com/kipperseguros
VITE_FACEBOOK_URL=https://www.facebook.com/kipperseguros
VITE_LINKEDIN_URL=https://www.linkedin.com/company/kipperseguros

# Botmaker Webchat (official public init.js — never put private tokens here)
VITE_BOTMAKER_WEBCHAT_ENABLED=true
# Example: https://go.botmaker.com/rest/webchat/p/XXXXX/init.js
VITE_BOTMAKER_WEBCHAT_SCRIPT_URL=https://go.botmaker.com/rest/webchat/p/J6P0M0R22Z/init.js

# Host port (docker-compose)
PORT=3000

